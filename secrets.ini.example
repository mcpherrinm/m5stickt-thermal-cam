[secrets]
; Wi-Fi network to join. The ESP32 only supports 2.4 GHz networks.
; Avoid double quotes and backslashes in these values.
wifi_ssid = My Network
wifi_password = my-password

; Optional static address. Leave static_ip empty (or omit these) to use DHCP.
; With static_ip set, gateway is required; subnet defaults to 255.255.255.0.
static_ip =
gateway =
subnet = 255.255.255.0
